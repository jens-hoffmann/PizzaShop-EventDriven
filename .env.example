# Copy to .env before running podman compose. Never commit the real .env file.

POSTGRES_USER=pizzashop
POSTGRES_PASSWORD=pizzashop
POSTGRES_DB=pizzashop

CATALOG_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
KITCHEN_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
KAFKA_UI_PORT=8090
SWAGGER_UI_PORT=8091

KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5432

# Simulated payment outcome: SUCCESS, FAILURE or RANDOM
PAYMENT_MODE=SUCCESS
PAYMENT_FAILURE_RATE=0.0
PAYMENT_DELAY_MS=1500

# Simulated kitchen timings
KITCHEN_ACCEPT_DELAY_MS=1000
KITCHEN_PREPARATION_DELAY_MS=4000
